# ==============================================================================
# PRODUCT CODE MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Sao chép file này thành .env và điền các thông tin thực tế của bạn:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH HỆ THỐNG & PROFILE
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU MYSQL 8.4 (DATABASE)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=product_code_manager
DB_USER=root
DB_PASSWORD=your_mysql_password_here

MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=product_code_manager
MYSQL_USER=pcm_user
MYSQL_PASSWORD=pcm_password

# ------------------------------------------------------------------------------
# 3. BẢO MẬT & XÁC THỰC (SECURITY & JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_length_here
JWT_EXPIRATION_MS=86400000

ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin@123

# ------------------------------------------------------------------------------
# 4. LƯU TRỮ HÌNH ẢNH ĐÁM MÂY (CLOUDINARY)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=products

# ------------------------------------------------------------------------------
# 5. GIAO DIỆN WEB QUẢN TRỊ (REACT + VITE FRONTEND)
# ------------------------------------------------------------------------------
VITE_PORT=5173
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_TARGET=http://localhost:8080

# ------------------------------------------------------------------------------
# 6. ỨNG DỤNG DI ĐỘNG (EXPO / REACT NATIVE MOBILE APP)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_CLOUDFLARE_URL=https://your-cloudflare-subdomain.trycloudflare.com/api/v1
EXPO_PUBLIC_LOCAL_LAN_URL=http://your-computer-ip:8080/api/v1

